pkgname=avd-fw
pkgver=0.1
pkgrel=1
pkgdesc='Firmware for Apple/Asahi AVD video decoder V4L2 driver'
arch=('any')
url='https://github.com/AsahiLinux/avd-fw'
license=('MIT')
source=("$url/archive/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

makedepends=(
  'meson>=1.3.0'
  'clang'
  'llvm'
  'lld'
)

build() {
  cd "$pkgname-$pkgver"

  CFLAGS= CXXFLAGS= LDFLAGS= \
  meson setup build \
    --prefix=/usr \
    --libdir=lib \
    -Dfirmwaredir=firmware/updates \
    --cross-file=./llvm.ini

  meson compile -C build
}

package() {
  cd "$pkgname-$pkgver"

  meson install -C build --destdir "$pkgdir"

  # The upstream Meson install may not create the expected hierarchy
  # depending on the configured prefix, so keep the firmware location
  # consistent with the RPM package.
  install -d "$pkgdir/usr/lib/firmware/updates"
}
